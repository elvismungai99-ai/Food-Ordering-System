# Base URL of the deployed Spring Boot backend API.
# Consumed by `src/api/axios.ts` during production builds.
#
# On Vercel: set the same value as a Project Environment Variable
# (Settings -> Environment Variables -> VITE_API_BASE_URL).
# The Vercel value takes precedence over this file during Vercel builds.
#
# To run a production build locally, copy this file to `.env.production`
# and replace the placeholder with your real backend URL.
VITE_API_BASE_URL=https://food-ordering-system-wu1z.onrender.com
